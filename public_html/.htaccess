RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# The PHP API no longer lives here: it is served from api.izitopups.com
# (see backend/ in the repo). Hostinger's Git deploy replaces this folder
# on every deploy, so nothing but this file should be placed in it.

# Security headers
Header always set X-Content-Type-Options nosniff
Header always set X-Frame-Options DENY
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy strict-origin-when-cross-origin

# Block sensitive files
<FilesMatch "\.(sql|env|log|sh|git)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>
